# `npm start` and `npm run call:test` read .env themselves (Node's --env-file-if-exists); other commands need the
# values exported in the shell.
# Placeholders only. Never commit real values. Everything below is read server-side.

# --- Server -------------------------------------------------------------------------------------
PORT=4000
# Comma-separated browser origins allowed to call the API cross-origin, or *. Empty = same-origin only
# (the bundled website needs nothing; the Android app is not a browser and needs nothing).
CORS_ORIGINS=
# If set, POST/DELETE on /api/v1/cattle/* require "Authorization: Bearer <token>". Minimum protection, not full auth.
API_WRITE_TOKEN=
# Where the cattle AOI/job JSON store lives (local-development store; NOT production durable)
CATTLE_STORE_PATH=
# true = create one clearly-flagged demo farm on first run
SEED_DEMO_DATA=false

# --- Weather providers --------------------------------------------------------------------------
# Open-Meteo works without a key for non-commercial use. A commercial key switches to customer-api.open-meteo.com.
OPEN_METEO_API_KEY=
# NASA POWER needs no credentials.

# --- Google Earth Engine (satellite NDVI / SMAP soil moisture / IMERG rain) ---------------------
# Requires: pip install earthengine-api, a Google Cloud project with the Earth Engine API enabled, and one of:
#   a service-account key file path below, or `earthengine authenticate` run as the server user.
EE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# python3 interpreter used for the worker (default python3) and an optional different worker script
EE_PYTHON=
EE_WORKER_PATH=
# IMERG Final lags by months; point this at a Late/Early collection id for recent rain totals
EE_IMERG_COLLECTION=NASA/GPM_L3/IMERG_V07
CATTLE_JOB_TIMEOUT_MS=180000

# --- Text generation (optional; any OpenAI-compatible /chat/completions endpoint) ---------------
# Gemma 3 4B can be served behind such an endpoint (vLLM, Ollama /v1, ...). Setting these does not make a model
# exist: you must run one. Unset = deterministic template narration is used.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000

# --- Text to speech (optional; separate from text generation) ------------------------------------
# POST {text, language, voice} -> audio/* bytes. Unset = clients use on-device speech and say so.
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=

# --- Officer sign-in (Supabase Auth) -------------------------------------------------------------
# Dashboard -> Project Settings -> API. The anon (publishable) key is public by design: the server hands it to the browser.
# Never put the privileged Supabase server key here or anywhere in this project, and never in apps/saao-dashboard/public/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The User ID typed on the sign-in form becomes the account email <userId>@<AUTH_EMAIL_DOMAIN>. Create the Supabase users with that email.
AUTH_EMAIL_DOMAIN=

# --- Demo officer login (recordings only) ---------------------------------------------------------
# true = the old shared-code officer login also works (user ID saao_talanda_01, the code below). Unset or false = it does not work at all.
DEMO_MODE=false
# The demo login's password. Read only when DEMO_MODE=true; there is no built-in default, so pick your own.
EDEN_OFFICER_CODE=

# --- NASA Earthdata and phone calls ---------------------------------------------------------------
# Copy to .env (gitignored) and fill in. Free account: https://urs.earthdata.nasa.gov/users/new
# Used by research/acquire/appeears_points.py and research/acquire/grace_fo.py (earthaccess).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Phone calls through Awaj Digital (services/api/src/awaj.ts). Token: Awaj dashboard -> Profile -> API Tokens.
# AWAJ_SENDER is an active caller number on the account. Calls stay dry runs until AWAJ_LIVE=1.
AWAJ_API_TOKEN=
AWAJ_SENDER=
AWAJ_LIVE=0
# Optional: TTS voice (female or male) and a secret for the keypad-survey webhook URL (...?key=<secret>)
AWAJ_VOICE=female
AWAJ_WEBHOOK_KEY=
# Keypad menu: the approved recording of the crop menu (npm run call:test -- --upload-menu menu.m4a), or a two-question
# survey template built in the Awaj dashboard; the officer's number for key 9; and this server's public address,
# so Awaj can post the pressed keys back
AWAJ_MENU_VOICE=
AWAJ_SURVEY_TEMPLATE=
AWAJ_OFFICER_NUMBER=
PUBLIC_BASE_URL=
