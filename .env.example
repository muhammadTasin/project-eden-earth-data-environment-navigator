# Copy this file to `.env` (git-ignored) and fill in only what you need. PLACEHOLDERS ONLY HERE: never commit real values.
# `npm start`, `npm run call:test` and `npm run check:integrations` read `.env` themselves (Node's --env-file-if-exists); other
# commands need the values exported in the shell. Everything below is read on the server and never reaches the website.
#
# Nothing is required to run the dashboard and the planner: with an empty .env they work from the built-in data and the free,
# no-key services (NASA POWER, Open-Meteo, NASA GIBS). The only thing you need for the manager screens is the Supabase block.
# Run `npm run check:integrations` to see what is set and which services answer; docs/integrations.md explains each one.

# === Server =========================================================================================
# Port the server listens on.
PORT=4000
# Comma-separated browser origins allowed to call the API from another website, or *. Empty = same-origin only
# (the bundled website needs nothing; the Android app is not a browser and needs nothing).
CORS_ORIGINS=
# 1 = never call the network for NASA POWER climate data: use the saved copy, then the committed sample file (demo without wifi).
# (The weather tab's Open-Meteo forecast and the browser's map tiles still need internet.)
OFFLINE=0
# If set, POST/DELETE on /api/v1/cattle/* require "Authorization: Bearer <token>". Minimum protection, not full authentication.
API_WRITE_TOKEN=
# Where the cattle farm/job JSON store lives (local-development store; not production durable). Empty = services/api/.data/.
CATTLE_STORE_PATH=
# true = create one clearly-flagged DEMO farm on first run (the cattle screens then show "[demo]").
SEED_DEMO_DATA=false
# Developer overrides (empty = the built-in paths): the officer-desk JSON store, the daily NASA update file, the locations file.
EDEN_OFFICER_STORE=
EDEN_LIVE_FILE=
LOCATIONS_FILE=

# === Manager sign-in: Supabase Auth (REAL, needed for the manager screens) ==============================
# Free plan available (limits: https://supabase.com/pricing). Create a project, then Dashboard -> Project Settings -> API.
# The anon (publishable) key is public by design: the server hands it to the browser. NEVER put the privileged service-role key
# here or anywhere in this project, and never in apps/saao-dashboard/public/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The User ID typed on the sign-in form becomes the account email <userId>@<AUTH_EMAIL_DOMAIN>. Create the Supabase users
# with that email, and set app_metadata {"role":"manager","site":"talanda"} on them (never user_metadata).
AUTH_EMAIL_DOMAIN=

# === Demo officer login (recordings only; simulated) =================================================
# true = the old shared-code officer login also works (user ID saao_talanda_01, the code below). false/unset = it does not work.
DEMO_MODE=false
# The demo login's password. Read only when DEMO_MODE=true; there is no built-in default, so pick your own.
EDEN_OFFICER_CODE=

# === Weather ============================================================================================
# Open-Meteo forecast: FREE without a key for non-commercial use (terms: https://open-meteo.com/en/terms). A paid/commercial key
# switches the server to customer-api.open-meteo.com. NASA POWER (climate card, weather observations) needs NO key at all.
OPEN_METEO_API_KEY=

# === Google Earth Engine: NDVI, SMAP soil moisture, IMERG rain for the cattle feature ===================
# FREE for non-commercial research use after registration (confirm the current terms at https://earthengine.google.com/).
# Needs: `pip install earthengine-api`, a Google Cloud project with the Earth Engine API enabled, and ONE of:
# a service-account key file path below, or `earthengine authenticate` run as the server user. Unset = the satellite part of
# the cattle screens says "unavailable".
EE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# python3 interpreter used for the worker (default python3) and an optional different worker script.
EE_PYTHON=
EE_WORKER_PATH=
# IMERG Final lags by months; point this at a Late/Early collection id for recent rain totals.
EE_IMERG_COLLECTION=NASA/GPM_L3/IMERG_V07
# How long one cattle job may run, in milliseconds.
CATTLE_JOB_TIMEOUT_MS=180000

# === Text generation: LLM (optional; PAID or self-hosted) ===============================================
# Any OpenAI-compatible /chat/completions endpoint (vLLM, Ollama /v1 on your own machine is free, a hosted gateway is paid).
# Setting these does not make a model exist: you must run one. Unset = a fixed, checked template wording is used.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=15000

# === Text to speech: server-side voice (optional; usually PAID) =========================================
# POST {text, language, voice} -> audio/* bytes, behind any thin proxy you run. Unset = the browser's own speech is used
# (quality varies by device) and the screens say so.
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=

# === Phone calls: Awaj Digital (PAID; every call is billed) ==========================================
# https://awajdigital.com/ . Token: Awaj dashboard -> Profile -> API Tokens. Direct TTS needs the "direct broadcast" and
# "AI TTS" permissions on the account (ask their support). Nothing is dialled unless the token, the sender AND AWAJ_LIVE=1
# are all set: until then every call screen is a DEMO showing what would be sent.
AWAJ_API_TOKEN=
# An active caller number on the account (the API lists them).
AWAJ_SENDER=
# 1 = real, billed calls. 0 or unset = dry runs only.
AWAJ_LIVE=0
# Voice for read-aloud calls: female or male.
AWAJ_VOICE=female
# Optional: override the API address (default https://api.awajdigital.com/api).
AWAJ_BASE_URL=
# Keypad menu: the approved recording of the crop menu (npm run call:test -- --upload-menu menu.m4a), OR a two-question survey
# template built in the Awaj dashboard; the officer's number for key 9.
AWAJ_MENU_VOICE=
AWAJ_SURVEY_TEMPLATE=
AWAJ_OFFICER_NUMBER=
# This server's public address, so Awaj can post the pressed keys back, and a secret for that webhook address (...?key=<secret>).
PUBLIC_BASE_URL=
AWAJ_WEBHOOK_KEY=

# === NASA Earthdata and other NASA services (read only in services/api/src/config.ts) ====================
# Earthdata Login: FREE account at https://urs.earthdata.nasa.gov/users/new . Gives access to SMAP, IMERG, MODIS/VIIRS NDVI,
# AppEEARS, Harmony and ASF. Used by the NIGHTLY update job and the research scripts (research/acquire/*.py), NOT by the running
# website. In GitHub the same two values are the repository secrets EARTHDATA_USERNAME / EARTHDATA_PASSWORD.
# (The field guide calls them EDL_USER / EDL_PASS; the server accepts either spelling.)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# EDL_USER=
# EDL_PASS=
# Optional Earthdata bearer token: https://urs.earthdata.nasa.gov/profile -> Generate Token (Harmony, ASF, AppEEARS).
EARTHDATA_TOKEN=
# NASA FIRMS active-fire MAP_KEY: FREE, emailed: https://firms.modaps.eosdis.nasa.gov/api/map_key/ . 5,000 transactions per
# 10 minutes. NO feature uses it yet.
FIRMS_MAP_KEY=
# api.nasa.gov key: FREE: https://api.nasa.gov . Empty = DEMO_KEY (30 requests/hour, 50/day, per the field guide); a registered
# key allows more. NO feature uses it yet.
NASA_API_KEY=
# NASA ADS bearer token: FREE with an ADS account: https://ui.adsabs.harvard.edu/user/settings/token . NO feature uses it yet.
ADS_API_TOKEN=
