<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. The sign-in session token (eden_auth_prefs) must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="eden_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="eden_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
